# =============================================================================
# Altair — environment variables
# Copy this file to `.env.local` and fill in real values. `.env*` is gitignored.
# =============================================================================

# --- Supabase (required) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side env (used by middleware and API handlers — same URL as VITE_SUPABASE_URL)
SUPABASE_URL=https://your-project.supabase.co

# Service role key — server-side ONLY, never ship to the client. Grants admin
# access to your Supabase project. Used by API handlers wrapped in withAuth().
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — direct Postgres connection string, used by the daily backup
# GitHub Actions workflow. Find this in Supabase → Database → Settings.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.your-project.supabase.co:5432/postgres

# --- Public app URL & CORS ---
# Comma-separated list of origins allowed to hit /api/*. Vercel preview
# deployments (*.vercel.app) are always allowed automatically.
ALLOWED_ORIGINS=http://localhost:5173,https://altair.example.com

# Base URL of this Altair install — used when building links in notifications.
ALTAIR_BASE_URL=http://localhost:5173

# --- External API key (for /api/external/* and /api/ingest/*) ---
# Service-to-service calls (e.g. your CRM webhook posting to /api/ingest/engagement)
# present this key in the X-API-Key header.
ALTAIR_EXTERNAL_API_KEY=generate-a-long-random-string

# --- Notifications (all optional) ---
# Email via Gmail SMTP (fill GMAIL_USER + GMAIL_APP_PASSWORD to enable).
# For other providers, replace the transport in api/_lib/email.ts.
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=your-app-password

# From-address overrides for notification emails.
NOTIFICATION_FROM_NAME=Altair Notifications
NOTIFICATION_FROM_EMAIL=no-reply@example.com

# CC list on client-facing scheduling emails (comma-separated).
SCHEDULING_EMAIL_CC=

# Slack bot (fill both to enable Slack notifications).
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C12345678
